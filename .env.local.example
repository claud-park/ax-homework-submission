NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Email notifications (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=
APP_BASE_URL=http://localhost:3000

# 마일스톤 AI 생성 (Anthropic 직접 연결 — 서버 전용, 클라이언트 미노출)
ANTHROPIC_API_KEY=
MILESTONE_AI_MODEL=claude-haiku-4-5

# 체크업 세션 AI 처리 (OpenAI Whisper STT)
OPENAI_API_KEY=

# 로그인 허용 이메일 도메인 (fail-closed: 미설정 시 모든 로그인 거부)
ALLOWED_EMAIL_DOMAIN=dreamus.io

# --- Slack: 1on1 예약 앱 AX-1-on-1 (기존, recap과 별개 앱) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Slack: Admin user id (recap 발송 Admin 허용 목록으로도 사용) ---
ADMIN_SLACK_CLAUD=
ADMIN_SLACK_ALEX=
ADMIN_SLACK_JENNIFER=
# 선택. 설정하면 기존 Admin Slack 알림이 켜진다 (비워두면 알림 없음)
ADMIN_SLACK_CHANNEL_ID=

# --- Slack recap: 별도 앱 AX-1on1-Recap (초안 게시 + 챔피언 DM) ---
RECAP_SLACK_BOT_TOKEN=
RECAP_SLACK_SIGNING_SECRET=
# recap 초안이 올라갈 채널 ID
RECAP_SLACK_CHANNEL_ID=
# 선택. 설정하면 이 앱 ID(A...)에서 온 요청만 허용 (이중 방어)
RECAP_SLACK_APP_ID=
