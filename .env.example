# ax-homework-submission — runtime environment template
# 사용법:
#   1. 이 파일을 .env 로 복사
#   2. 빈 값을 실제 운영 값으로 채움
#   3. docker compose --env-file .env -p ax-homework-submission up -d 로 기동
#
# .env 는 .gitignore 처리됨. 절대 커밋하지 말 것.

# --- Supabase (NEXT_PUBLIC_* 은 클라이언트 번들에 박힘) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase 서버 전용 (절대 NEXT_PUBLIC_ prefix 금지) ---
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Email (Gmail SMTP via nodemailer) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=

# --- App base URL (이메일 본문 링크 등) ---
APP_BASE_URL=http://localhost:3000

# --- 로그인 허용 이메일 도메인 (fail-closed: 미설정 시 모든 로그인 거부) ---
ALLOWED_EMAIL_DOMAIN=dreamus.io

# --- Slack: 1on1 예약 앱 AX-1-on-1 (기존, recap과 별개 앱) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Slack: Admin user id (recap 발송 Admin 허용 목록으로도 사용) ---
ADMIN_SLACK_CLAUD=
ADMIN_SLACK_ALEX=
ADMIN_SLACK_JENNIFER=
# 선택. 설정하면 기존 Admin Slack 알림이 켜진다 (비워두면 알림 없음)
ADMIN_SLACK_CHANNEL_ID=

# --- Slack recap: 별도 앱 AX-1on1-Recap (초안 게시 + 챔피언 DM) ---
RECAP_SLACK_BOT_TOKEN=
RECAP_SLACK_SIGNING_SECRET=
# recap 초안이 올라갈 채널 ID
RECAP_SLACK_CHANNEL_ID=
# 선택. 설정하면 이 앱 ID(A...)에서 온 요청만 허용 (이중 방어)
RECAP_SLACK_APP_ID=
